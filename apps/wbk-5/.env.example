GEMINI_API_KEY=your_gemini_api_key

# Optional when the frontend should call a different token route than /api/livekit-token.
VITE_LIVEKIT_TOKEN_ENDPOINT=/api/livekit-token

# Required for in-app live voice via LiveKit.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional room prefix used by the token API route.
LIVEKIT_ROOM_PREFIX=learnendo-live
