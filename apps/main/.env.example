# Server-side only. Do not expose this in VITE_* vars or Vite define config.
GEMINI_API_KEY=your_gemini_api_key

# Optional when the frontend should call a different token route than /api/getToken.
VITE_LIVEKIT_TOKEN_ENDPOINT=/api/getToken

# Required for in-app live voice via LiveKit.
# Keep the URL here on the server side; the client receives the same URL from /api/getToken.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional room prefix used by the token API route.
LIVEKIT_ROOM_PREFIX=learnendo-live

# Local validation only. Keep false/absent for normal development against configured Firebase.
VITE_USE_FIREBASE_EMULATORS=false
VITE_DEBUG_EDITORIAL_SEQUENCE=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
