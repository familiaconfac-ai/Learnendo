# Server-side only. Do not expose this in VITE_* vars or Vite define config.
GEMINI_API_KEY=your_gemini_api_key

# Optional when the frontend should call a different token route than /api/getToken.
VITE_LIVEKIT_TOKEN_ENDPOINT=/api/getToken

# Required for in-app live voice via LiveKit.
# Keep the URL here on the server side; the client receives the same URL from /api/getToken.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional room prefix used by the token API route.
LIVEKIT_ROOM_PREFIX=learnendo-live

# Local validation only. Keep false/absent for normal development against configured Firebase.
VITE_USE_FIREBASE_EMULATORS=false
VITE_DEBUG_EDITORIAL_SEQUENCE=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080

# Public Web Push certificate key from Firebase Console > Cloud Messaging.
# This is intentionally a VITE_ variable; never put a service-account private key here.
VITE_FIREBASE_VAPID_KEY=your_public_web_push_vapid_key

# Server-side origin used to validate notification click destinations.
APP_ORIGIN=https://learnendo.vercel.app

# Server-only Firebase service-account JSON used by Vercel API routes.
# Store the complete JSON as one secret. Never prefix this variable with VITE_.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your_project_id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}

# Optional explicit project override. The service-account project_id is normally sufficient.
FIREBASE_PROJECT_ID=learnendo-6f4d3

# Server-only random value (at least 16 characters). Vercel sends it as Bearer authorization to cron routes.
CRON_SECRET=replace_with_a_long_random_secret
